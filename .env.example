DATABASE_URL=postgresql://colmeia:local_password@localhost:5432/colmeia?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000
# Session signing secret (32+ characters). Required by the current local-auth implementation.
AUTH_JWT_SECRET=
# Reserved OIDC configuration: no OIDC login flow is implemented yet.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
# OpenClaw runtime integration requires explicit version/contract verification.
OPENCLAW_IMAGE=
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# Colmeia Teams: leave blank to disable actual AI responses safely
COLMEIA_AI_API_KEY=
COLMEIA_AI_MODEL=
COLMEIA_AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# Optional transactional email webhook (HTTPS only)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Optional private directory for development email previews
MAIL_DEV_DIRECTORY=
# Private environment variable for the Next.js process
API_INTERNAL_URL=http://localhost:4000/api/v1
LOG_LEVEL=info

# P1/P2: server-only model credentials. COLMEIA_AI_API_KEY remains an OpenAI fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional trusted server override, primarily for controlled integration tests.
OPENAI_BASE_URL=
# Execution deadline: 1000..90000 milliseconds; default 90000.
EXECUTION_TIMEOUT_MS=90000
# P3: 32 random bytes encoded as 64 hex characters. Keep stable and backed up.
# Generate locally: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
RUNTIME_ENCRYPTION_KEY=
RUNTIME_QUEUE_NAME=colmeia-runtime

# AI Providers
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Deterministic workflows (no AI credentials required). Use a distinct queue per DB/environment.
WORKFLOW_QUEUE_NAME=colmeia-workflows
# Private persistent filesystem volume for uploaded documents. Share across API replicas.
FILE_STORAGE_PATH=.colmeia-storage
# Optional internal trial for organizations without a subscription (0 disables; maximum 90 days).
BILLING_TRIAL_DAYS=0
# Stripe is not implemented/homologated; these reserved variables do not enable charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
